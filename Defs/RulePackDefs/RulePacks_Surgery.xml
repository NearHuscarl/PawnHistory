<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<RulePackDef>
		<defName>PH_BotchedSurgeryCommon</defName>
		<rulePack>
			<rulesStrings>
				<li>CausingNewInjuries(injuryCount==0)-></li>
				<li>CausingNewInjuries(injuryCount==1)->, causing a wound on [PAWN_possessive] [InjuredParts] [Bloodloss]</li>
				<li>CausingNewInjuries(injuryCount>=2)->, causing multiple wounds on [PAWN_possessive] [InjuredParts] [Bloodloss]</li>

				<li>Severity(outcomeType==Minor)     ->slightly</li>
				<li>Severity(outcomeType==Major)     ->catastrophically</li>
				<li>Severity(outcomeType==Death)     ->fatally</li>
				<li>Severity(outcomeType==Sterilized)->hilariously</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>

	<RulePackDef>
		<defName>PH_BodyPartRemoved</defName>
		<include>
			<li>PH_BotchedSurgeryCommon</li>
		</include>
		<rulePack>
			<rulesStrings>
				<li>entry(intent==Harvest) ->[PAWN]'s [Part] was harvested by [Doctor].</li>
				<li>entry(intent==Amputate)->[PAWN]'s [Part] was amputated by [Doctor] due to [BadHediff].</li>

				<li>entryBotched(intent==Amputate)->[Doctor] [Severity] botched an amputation on [PAWN]'s [Part][CausingNewInjuries].</li>
				<li>entryBotched(intent==Harvest) ->[Doctor] [Severity] botched a harvest on [PAWN]'s [Part][CausingNewInjuries].</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>

	<RulePackDef>
		<defName>PH_BodyPartImplanted</defName>
		<include>
			<li>PH_BotchedSurgeryCommon</li>
		</include>
		<rulePack>
			<rulesStrings>
				<li>entry->[Doctor] installed [ImplantHediff_indefinite] in [PAWN]'s [Part].</li>

				<li>entryBotched->[Doctor] [Severity] botched the implantation of [ImplantHediff_indefinite] on [PAWN][CausingNewInjuries].</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>

	<RulePackDef>
		<defName>PH_BodyPartInstalled</defName>
		<include>
			<li>PH_BotchedSurgeryCommon</li>
		</include>
		<rulePack>
			<rulesStrings>
				<li>entry(type==Install)->[Doctor] installed [AddedPart_indefinite] on [PAWN].</li>
				<li>entry(type==Replace)->[Doctor] replaced [PAWN]'s [RemovedPart] with [AddedPart_indefinite].</li>
				<li>entry(type==Fix)    ->[Doctor] installed a healthy [AddedPart] on [PAWN] to treat [BadHediff].</li>

				<li>entryBotched->[Doctor] [Severity] botched the installation of [AddedPart_indefinite] on [PAWN][CausingNewInjuries].</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>

	<RulePackDef>
		<defName>PH_BodyPartModded</defName>
		<include>
			<li>PH_BotchedSurgeryCommon</li>
		</include>
		<rulePack>
			<rulesStrings>
				<li>ViolationNote(isViolation==True) ->, violating [PAWN_possessive] body</li>
				<li>ViolationNote(isViolation==False)-></li>

				<li>entry(type==Install,hasPartPosition==True) ->[Doctor] installed [AddedHediff_indefinite] on [PAWN]'s [Part][ViolationNote].</li>
				<li>entry(type==Install,hasPartPosition==False)->[Doctor] installed [AddedHediff_indefinite] on [PAWN][ViolationNote].</li>
				<li>entry(type==Replace)                       ->[Doctor] replaced [PAWN]'s [RemovedPart] with [AddedHediff_indefinite][ViolationNote].</li>
				<li>entry(type==Fix,hasPartPosition==True)     ->[Doctor] installed [AddedHediff_indefinite] on [PAWN]'s [Part] to treat [BadHediff][ViolationNote].</li>
				<li>entry(type==Fix,hasPartPosition==False)    ->[Doctor] installed [AddedHediff_indefinite] on [PAWN] to treat [BadHediff][ViolationNote].</li>

				<li>entryBotched->[Doctor] [Severity] botched the installation of [AddedHediff_indefinite] on [PAWN][CausingNewInjuries].</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>
</Defs>
